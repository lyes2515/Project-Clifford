imagenet\"                    # None = random init (only useful for debugging)\n","\n","IMG_SIZE    = (224, 224)\n","BATCH_PER_GPU = 32\n","strategy = tf.distribute.MirroredStrategy() if len(gpus) > 1 else tf.distribute.get_strategy()\n","N_REPLICAS = strategy.num_replicas_in_sync\n","print(\"Replicas in sync:\", N_REPLICAS)\n","BATCH_SIZE = BATCH_PER_GPU * N_REPLICAS\n","USE_MIXED_PRECISION = True\n","SEED        = 42\n","\n","EPOCHS_HEAD = 5        # phase 1: backbone frozen, only the new head trains\n","EPOCHS_FINE = 15       # phase 2: top of the backbone unfrozen (early stopping will cut this short)\n","LR_HEAD     = 1e-3\n","LR_FINE     = 5e-6\n","FINE_TUNE_LAST = 120   # number of backbone layers to unfreeze in phase 2 (BatchNorm stays frozen)\n","\n","keras.utils.set_random_seed(SEED)\n","if USE_MIXED_PRECISION:\n","    keras.mixed_precision.set_global_policy(\"mixed_float16\")\n","AUTOTUNE = tf.data.AUTOTUNE"]},{"cell_type":"markdown","id":"c100b004","metadata":{"papermill":{"duration":0.002682,"end_time":"2026-11-04T20:31:16.516059+00:00","exception":false,"start_time":"2026-11-04T20:31:16.513377+00:00","status":"completed"},"tags":[]},"source":["## 2. Load file list and make a fixed, stratified split\n","\n","The original notebook split a `tf.data` pipeline with `take`/`skip`. That pipeline reshuffles every time it is\n","iterated, so images near the split boundaries can move between train/val/test from one pass to the next.\n","Here the split is done **once, on file paths**, stratified by class, so every image lives in exactly one split."]},{"cell_type":"code","execution_count":3,"id":"ab51a5b9","metadata":{"execution":{"iopub.execute_input":"2026-11-04T20:31:16.522516Z","iopub.status.busy":"2026-11-04T20:31:16.522173Z","iopub.status.idle":"2026-11-04T20:31:17.879289Z","shell.execute_reply":"2026-11-04T20:31:17.878335Z"},"papermill":{"duration":1.362413,"end_time":"2026-11-04T20:31:17.881024+00:00","exception":false,"start_time":"2026-11-04T20:31:16.518611+00:00","status":"completed"},"tags":[]},"outputs":[{"name":"stdout","output_type":"stream","text":["Folders found: ['Abnormal', 'Normal']\n","Normal    -> label 0 |  10192 images\n","Abnormal  -> label 1 |  11941 images\n","    Lung_Opacity           6012\n","    Pneumonia              5929\n","train:  15493 images | Normal= 7134  Abnormal= 8359\n","val  :   4426 images | Normal= 2038  Abnormal= 2388\n","test :   2214 images | Normal= 1020  Abnormal= 1194\n"]}],"source":["VALID_EXT = {\".jpg\", \".jpeg\", \".png\", \".bmp\"}\n","\n","print(\"Folders found:\", os.listdir(DATA_DIR))\n","all_paths, all_labels = [], []\n","for label, name in enumerate(CLASS_NAMES):\n","    folder = os.path.join(DATA_DIR, name)\n","    files = []\n","    for root, _, fnames in os.walk(folder):          # walks into sub-folders too\n","        for f in sorted(fnames):\n","            if os.path.splitext(f)[1].lower() in VALID_EXT:\n","                files.append(os.path.join(root, f))\n","    files.sort()                                      # deterministic order -> reproducible split\n","    all_paths  += files\n","    all_labels += [label] * len(files)\n","    print(f\"{name:9s} -> label {label} | {len(files):6d} images\")\n","\n","    # breakdown per sub-folder (e.g. Pneumonia / Lung Opacity)\n","    sub = {}\n","    for p in files:\n","        key = os.path.relpath(os.path.dirname(p), folder)\n","        sub[key] = sub.get(key, 0) + 1\n","    if len(sub) > 1 or \".\" not in sub:\n","        for k, v in sub.items():\n","            print(f\"    {k:20s} {v:6d}\")\n","\n","# 70 % train / 20 % val / 10 % test, stratified\n","train_paths, tmp_paths, train_labels, tmp_labels = train_test_split(\n","    all_paths, all_labels, test_size=0.30, stratify=all_labels, random_state=SEED)\n","val_paths, test_paths, val_labels, test_labels = train_test_split(\n","    tmp_paths, tmp_labels, test_size=1/3, stratify=tmp_labels, random_state=SEED)\n","\n","for name, y in [(\"train\", train_labels), (\"val\", val_labels), (\"test\", test_labels)]:\n","    y = np.array(y)\n","    print(f\"{name:5s}: {len(y):6d} images | Normal={np.sum(y==0):5d}  Abnormal={np.sum(y==1):5d}\")"]},{"cell_type":"code","execution_count":4,"id":"6972cdbc","metadata":{"execution":{"iopub.execute_input":"2026-11-04T20:31:17.888341Z","iopub.status.busy":"2026-11-04T20:31:17.888007Z","iopub.status.idle":"2026-11-04T20:31:19.027483Z","shell.execute_reply":"2026-11-04T20:31:19.026708Z"},"papermill":{"duration":1.14879,"end_time":"2026-11-04T20:31:19.03295+00:00","exception":false,"start_time":"2026-11-04T20:31:17.88416+00:00","status":"completed"},"tags":[]},"outputs":[{"data":{"image/png":"\n","text/plain":["<Figure size 2000x400 with 6 Axes>"]},"metadata":{},"output_type":"display_data"}],"source":["# Quick look at a few real images\n","rng_vis = np.random.default_rng(SEED)\n","idx = rng_vis.choice(len(train_paths), 6, replace=False)\n","fig, axes = plt.subplots(1, 6, figsize=(20, 4))\n","for ax, i in zip(axes, idx):\n","    ax.imshow(Image.open(train_paths[i]).convert(\"L\"), cmap=\"gray\")\n","    ax.set_title(CLASS_NAMES[train_labels[i]]); ax.axis(\"off\")\n","plt.show()"]},{"cell_type":"markdown","id":"d2b84d8b","metadata":{"papermill":{"duration":0.005039,"end_time":"2026-11-04T20:31:19.04389+00:00","exception":false,"start_time":"2026-11-04T20:31:19.038851+00:00","status":"completed"},"tags":[]},"source":["## 3. Synthetic image generation to balance the classes\n","\n","Normal is the minority class so generate new Normal images until **both classes are balanced**.\n","\n","**How the synthetic images are made** — each one starts from a random *real, training-split* Normal image and gets a\n","random combination of:\n","- a small **geometric warp** (rotation ±10°, shift ±5 %, zoom 0.92–1.08) plus a smooth **elastic deformation**\n","- **intensity changes** (gamma, contrast, brightness)\n","- light **sensor noise** and optional slight blur\n","\n","Design choices that matter for medical images:\n","- **No horizontal flips** — flipping a chest X-ray moves the heart to the right side, which is anatomically wrong.\n","- Borders are filled by **edge replication**, not black, so the model can't learn \"black corners = synthetic\".\n","- Synthetic images are made **only from training images** and are **only added to the training set**.\n","  Validation and test stay 100 % real, so the reported metrics are not inflated."]},{"cell_type":"code","execution_count":5,"id":"73a8190c","metadata":{"execution":{"iopub.execute_input":"2026-11-04T20:31:19.055445Z","iopub.status.busy":"2026-11-04T20:31:19.055077Z","iopub.status.idle":"2026-11-04T20:31:19.065632Z","shell.execute_reply":"2026-11-04T20:31:19.064861Z"},"papermill":{"duration":0.018178,"end_time":"2026-11-04T20:31:19.067162+00:00","exception":false,"start_time":"2026-11-04T20:31:19.048984+00:00","status":"completed"},"tags":[]},"outputs":[],"source":["def random_warp(img, rng, max_rot=10, max_shift=0.05, zoom=(0.92, 1.08),\n","                elastic_px=2.0, elastic_sigma=8):\n","    \"\"\"Rotation + shift + zoom + elastic deformation in ONE resampling step. img: float32 [H,W] in 0..1\"\"\"\n","    h, w = img.shape\n","    yy, xx = np.meshgrid(np.arange(h), np.arange(w), indexing=\"ij\")\n","    cy, cx = (h - 1) / 2, (w - 1) / 2\n","\n","    theta = np.deg2rad(rng.uniform(-max_rot, max_rot))\n","    s = rng.uniform(*zoom)\n","    ty, tx = rng.uniform(-max_shift, max_shift, 2) * np.array([h, w])\n","\n","    y0, x0 = yy - cy - ty, xx - cx - tx                      # output -> input (inverse mapping)\n","    xs = ( np.cos(theta) * x0 + np.sin(theta) * y0) / s + cx\n","    ys = (-np.sin(theta) * x0 + np.cos(theta) * y0) / s + cy\n","\n","    for field in (\"dx\", \"dy\"):                                # smooth random displacement field\n","        d = gaussian_filter(rng.standard_normal((h, w)), elastic_sigma)\n","        d = d / (d.std() + 1e-8) * elastic_px\n","        if field == \"dx\": xs = xs + d\n","        else:             ys = ys + d\n","\n","    return map_coordinates(img, [ys, xs], order=1, mode=\"nearest\")\n","\n","\n","def random_intensity(img, rng):\n","    gamma = rng.uniform(0.80, 1.25)\n","    img = np.clip(img, 0, 1) ** gamma\n","    mean = img.mean()\n","    img = (img - mean) * rng.uniform(0.85, 1.15) + mean + rng.uniform(-0.05, 0.05)\n","    if rng.random() < 0.5:\n","        img = gaussian_filter(img, rng.uniform(0.3, 0.7))\n","    img = img + rng.normal(0, rng.uniform(0.0, 0.02), img.shape)\n","    return np.clip(img, 0, 1)\n","\n","\n","def make_synthetic(path, rng):\n","    img = Image.open(path).convert(\"L\").resize(IMG_SIZE[::-1], Image.BILINEAR)\n","    arr = np.asarray(img, dtype=np.float32) / 255.0\n","    arr = random_intensity(random_warp(arr, rng), rng)\n","    return Image.fromarray((arr * 255).astype(np.uint8), mode=\"L\")"]},{"cell_type":"code","execution_count":6,"id":"7c0f3014","metadata":{"execution":{"iopub.execute_input":"2026-11-04T20:31:19.07871Z","iopub.status.busy":"2026-11-04T20:31:19.078365Z","iopub.status.idle":"2026-11-04T20:33:13.273515Z","shell.execute_reply":"2026-11-04T20:33:13.272678Z"},"papermill":{"duration":114.208295,"end_time":"2026-11-04T20:33:13.280589+00:00","exception":false,"start_time":"2026-11-04T20:31:19.072294+00:00","status":"completed"},"tags":[]},"outputs":[{"name":"stdout","output_type":"stream","text":["Training counts: {'Normal': np.int64(7134), 'Abnormal': np.int64(8359)}\n","Minority class: Normal -> generating 1225 synthetic images\n","Saved 1225 synthetic images to /kaggle/working/synthetic_Normal\n"]}],"source":["counts = np.bincount(train_labels)\n","minority = int(np.argmin(counts))\n","n_needed = int(counts.max() - counts.min())\n","print(f\"Training counts: {dict(zip(CLASS_NAMES, counts))}\")\n","print(f\"Minority class: {CLASS_NAMES[minority]} -> generating {n_needed} synthetic images\")\n","\n","SYNTH_DIR = os.path.join(OUT_DIR, f\"synthetic_{CLASS_NAMES[minority]}\")\n","shutil.rmtree(SYNTH_DIR, ignore_errors=True)\n","os.makedirs(SYNTH_DIR)\n","\n","rng = np.random.default_rng(SEED)\n","minority_train = [p for p, y in zip(train_paths, train_labels) if y == minority]\n","sources = rng.choice(len(minority_train), n_needed, replace=n_needed > len(minority_train))\n","\n","synth_paths, pairs = [], []\n","for k, src_idx in enumerate(sources):\n","    src = minority_train[src_idx]\n","    out = os.path.join(SYNTH_DIR, f\"synth_{k:05d}.png\")\n","    make_synthetic(src, rng).save(out)\n","    synth_paths.append(out)\n","    if k < 6: pairs.append((src, out))\n","print(f\"Saved {len(synth_paths)} synthetic images to {SYNTH_DIR}\")"]},{"cell_type":"code","execution_count":7,"id":"e4790294","metadata":{"execution":{"iopub.execute_input":"2026-11-04T20:33:13.293627Z","iopub.status.busy":"2026-11-04T20:33:13.292688Z","iopub.status.idle":"2026-11-04T20:33:14.042141Z","shell.execute_reply":"2026-11-04T20:33:14.041263Z"},"papermill":{"duration":0.769877,"end_time":"2026-11-04T20:33:14.055887+00:00","exception":false,"start_time":"2026-11-04T20:33:13.28601+00:00","status":"completed"},"tags":[]},"outputs":[{"data":{"image/png":"\n","text/plain":["<Figure size 1920x660 with 12 Axes>"]},"metadata":{},"output_type":"display_data"}],"source":["# Original (top) vs synthetic (bottom)\n","fig, axes = plt.subplots(2, len(pairs), figsize=(3.2 * len(pairs), 6.6))\n","for j, (src, syn) in enumerate(pairs):\n","    axes[0, j].imshow(Image.open(src).convert(\"L\").resize(IMG_SIZE[::-1]), cmap=\"gray\"); axes[0, j].axis(\"off\")\n","    axes[1, j].imshow(Image.open(syn), cmap=\"gray\");                                     axes[1, j].axis(\"off\")\n","axes[0, 0].set_title(\"Real (source)\", loc=\"left\"); axes[1, 0].set_title(\"Synthetic\", loc=\"left\")\n","plt.tight_layout(); plt.show()"]},{"cell_type":"code","execution_count":8,"id":"dde32822","metadata":{"execution":{"iopub.execute_input":"2026-11-04T20:33:14.084115Z","iopub.status.busy":"2026-11-04T20:33:14.083336Z","iopub.status.idle":"2026-11-04T20:33:14.214122Z","shell.execute_reply":"2026-11-04T20:33:14.213375Z"},"papermill":{"duration":0.147039,"end_time":"2026-11-04T20:33:14.216648+00:00","exception":false,"start_time":"2026-11-04T20:33:14.069609+00:00","status":"completed"},"tags":[]},"outputs":[{"data":{"image/png":"\n","text/plain":["<Figure size 600x400 with 1 Axes>"]},"metadata":{},"output_type":"display_data"},{"name":"stdout","output_type":"stream","text":["Balanced training counts: {'Normal': np.int64(8359), 'Abnormal': np.int64(8359)}\n"]}],"source":["# Final training set = real train + synthetic minority images.  Val / test are untouched.\n","train_paths_bal  = train_paths + synth_paths\n","train_labels_bal = train_labels + [minority] * len(synth_paths)\n","\n","before, after = np.bincount(train_labels), np.bincount(train_labels_bal)\n","fig, ax = plt.subplots(figsize=(6, 4))\n","x = np.arange(2); w = 0.38\n","ax.bar(x - w/2, before, w, label=\"Before\"); ax.bar(x + w/2, after, w, label=\"After (with synthetic)\")\n","ax.set_xticks(x); ax.set_xticklabels(CLASS_NAMES); ax.set_ylabel(\"Training images\"); ax.legend()\n","ax.set_title(\"Training-set class balance\"); plt.show()\n","print(\"Balanced training counts:\", dict(zip(CLASS_NAMES, after)))"]},{"cell_type":"markdown","id":"6d2f2c3e","metadata":{"papermill":{"duration":0.013966,"end_time":"2026-11-04T20:33:14.246513+00:00","exception":false,"start_time":"2026-11-04T20:33:14.232547+00:00","status":"completed"},"tags":[]},"source":["## 4. Input pipeline\n","Images are fed as raw `0–255` floats. The **backbone-specific normalisation lives inside the model** (next section), so training,\n","evaluation and inference can never get out of sync."]},{"cell_type":"code","execution_count":9,"id":"93c91565","metadata":{"execution":{"iopub.execute_input":"2026-11-04T20:33:14.277136Z","iopub.status.busy":"2026-11-04T20:33:14.276262Z","iopub.status.idle":"2026-11-04T20:33:16.653037Z","shell.execute_reply":"2026-11-04T20:33:16.652347Z"},"papermill":{"duration":2.394204,"end_time":"2026-11-04T20:33:16.654861+00:00","exception":false,"start_time":"2026-11-04T20:33:14.260657+00:00","status":"completed"},"tags":[]},"outputs":[],"source":["def load_image(path, label):\n","    raw = tf.io.read_file(path)\n","    img = tf.io.decode_image(raw, channels=3, expand_animations=False)\n","    img.set_shape([None, None, 3])\n","    img = tf.cast(tf.round(tf.image.resize(img, IMG_SIZE)), tf.uint8)\n","    return img, label\n","\n","def to_float(img, label):\n","    return tf.cast(img, tf.float32), label\n","\n","def make_dataset(paths, labels, training):\n","    paths, labels = np.array(paths), np.array(labels, dtype=np.float32)\n","    if training:\n","        perm = np.random.default_rng(SEED).permutation(len(paths))\n","        paths, labels = paths[perm], labels[perm]\n","    ds = tf.data.Dataset.from_tensor_slices((paths, labels))\n","    ds = ds.map(load_image, num_parallel_calls=AUTOTUNE, deterministic=True).cache()\n","    if training:\n","        ds = ds.shuffle(min(len(paths), 4096), seed=SEED, reshuffle_each_iteration=True)\n","    return ds.map(to_float, num_parallel_calls=AUTOTUNE).batch(BATCH_SIZE).prefetch(AUTOTUNE)\n","\n","train_ds = make_dataset(train_paths_bal, train_labels_bal, training=True)\n","val_ds   = make_dataset(val_paths,  val_labels,  training=False)\n","test_ds  = make_dataset(test_paths, test_labels, training=False)   # no shuffling -> predictions line up with test_labels"]},{"cell_type":"markdown","id":"6690c9c3","metadata":{"papermill":{"duration":0.014173,"end_time":"2026-11-04T20:33:16.683483+00:00","exception":false,"start_time":"2026-11-04T20:33:16.66931+00:00","status":"completed"},"tags":[]},"source":["## 5. Model : pre-trained backbone + new classification head\n","\n","**Why DenseNet121 as the default?**\n","- It is the architecture behind **CheXNet**, so it has a strong track record on exactly this modality.\n","- Dense connections reuse features across layers, which works well on subtle textures (lung opacity, infiltrates) and is parameter-efficient.\n","- It fine-tunes reliably with small learning rates.\n","\n","Alternatives are one config change away (`BACKBONE = ...`): **ResNet50V2** (robust baseline), **EfficientNetB0** (smallest/fastest), **VGG16** (heavy, mostly for comparison).\n","AlexNet is not available in `keras.applications` and is outdated compared with all of the above.\n","\n","Architecture: `augmentation (train only) → preprocessing → backbone → GlobalAveragePooling → Dropout → Dense(1, sigmoid)`"]},{"cell_type":"code","execution_count":10,"id":"e0c86c0f","metadata":{"execution":{"iopub.execute_input":"2026-11-04T20:33:16.712785Z","iopub.status.busy":"2026-11-04T20:33:16.712316Z","iopub.status.idle":"2026-11-04T20:33:22.205011Z","shell.execute_reply":"2026-11-04T20:33:22.204148Z"},"papermill":{"duration":5.509063,"end_time":"2026-11-04T20:33:22.206567+00:00","exception":false,"start_time":"2026-11-04T20:33:16.697504+00:00","status":"completed"},"tags":[]},"outputs":[{"name":"stdout","output_type":"stream","text":["Downloading data from https://storage.googleapis.com/tensorflow/keras-applications/densenet/densenet121_weights_tf_dim_ordering_tf_kernels_notop.h5\n","\u001b[1m29084464/29084464\u001b[0m \u001b[32m━━━━━━━━━━━━━━━━━━━━\u001b[0m\u001b[37m\u001b[0m \u001b[1m0s\u001b[0m 0us/step\n"]},{"data":{"text/html":["<pre style=\"white-space:pre;overflow-x:auto;line-height:normal;font-family:Menlo,'DejaVu Sans Mono',consolas,'Courier New',monospace\"><span style=\"font-weight: bold\">Model: \"clifford_densenet121\"</span>\n","</pre>\n"],"text/plain":["\u001b[1mModel: \"clifford_densenet121\"\u001b[0m\n"]},"metadata":{},"output_type":"display_data"},{"data":{"text/html":["<pre style=\"white-space:pre;overflow-x:auto;line-height:normal;font-family:Menlo,'DejaVu Sans Mono',consolas,'Courier New',monospace\">┏━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┳━━━━━━━━━━━━━━━━━━━━━━━━┳━━━━━━━━━━━━━━━┓\n","┃<span style=\"fon