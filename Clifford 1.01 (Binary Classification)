(26.85 MB)\n","</pre>\n"],"text/plain":["\u001b[1m Non-trainable params: \u001b[0m\u001b[38;5;34m7,037,504\u001b[0m (26.85 MB)\n"]},"metadata":{},"output_type":"display_data"}],"source":["BACKBONES = {\n","    \"densenet121\":    (keras.applications.DenseNet121,    keras.applications.densenet.preprocess_input),\n","    \"resnet50v2\":     (keras.applications.ResNet50V2,     keras.applications.resnet_v2.preprocess_input),\n","    \"efficientnetb0\": (keras.applications.EfficientNetB0, keras.applications.efficientnet.preprocess_input),\n","    \"vgg16\":          (keras.applications.VGG16,          keras.applications.vgg16.preprocess_input),\n","}\n","\n","@keras.utils.register_keras_serializable(package=\"clifford\")\n","class BackbonePreprocess(layers.Layer):\n","    \"\"\"Applies the exact normalisation the chosen ImageNet backbone was trained with.\"\"\"\n","    def __init__(self, backbone, **kwargs):\n","        super().__init__(**kwargs)\n","        self.backbone = backbone\n","    def call(self, x):\n","        return BACKBONES[self.backbone][1](x)\n","    def get_config(self):\n","        cfg = super().get_config(); cfg.update(backbone=self.backbone); return cfg\n","\n","\n","def build_model(backbone_name=BACKBONE):\n","    ctor, _ = BACKBONES[backbone_name]\n","    base = ctor(include_top=False, weights=WEIGHTS, input_shape=IMG_SIZE + (3,), name=\"backbone\")\n","    base.trainable = False                                   # phase 1: frozen\n","\n","    # Light augmentation, active only while training. No horizontal flip (anatomy!).\n","    augmentation = keras.Sequential([\n","        layers.RandomRotation(0.03, fill_mode=\"nearest\"),\n","        layers.RandomTranslation(0.04, 0.04, fill_mode=\"nearest\"),\n","        layers.RandomZoom(0.08, fill_mode=\"nearest\"),\n","        layers.RandomContrast(0.10),\n","    ], name=\"augmentation\")\n","\n","    inputs = keras.Input(shape=IMG_SIZE + (3,), name=\"image\")\n","    x = augmentation(inputs)\n","    x = BackbonePreprocess(backbone_name, name=\"preprocess\")(x)\n","    x = base(x, training=False)                              # keep BatchNorm in inference mode\n","    x = layers.GlobalAveragePooling2D(name=\"gap\")(x)\n","    x = layers.Dropout(0.3, name=\"head_dropout\")(x)\n","    outputs = layers.Dense(1, activation=\"sigmoid\", name=\"pred\")(x)\n","    return keras.Model(inputs, outputs, name=f\"clifford_{backbone_name}\")\n","\n","\n","def compile_model(model, lr):\n","    model.compile(\n","        optimizer=keras.optimizers.Adam(learning_rate=lr),\n","        loss=\"binary_crossentropy\",\n","        metrics=[keras.metrics.BinaryAccuracy(name=\"accuracy\"),\n","                 keras.metrics.AUC(name=\"auc\"),\n","                 keras.metrics.Precision(name=\"precision\"),\n","                 keras.metrics.Recall(name=\"recall\")],\n","    )\n","\n","model = build_model()\n","compile_model(model, LR_HEAD)\n","model.summary()"]},{"cell_type":"markdown","id":"aec440ee","metadata":{"papermill":{"duration":0.014623,"end_time":"2026-10-23T19:54:08.016007+00:00","exception":false,"start_time":"2026-10-23T19:54:08.001384+00:00","status":"completed"},"tags":[]},"source":["## 6. Training\n","\n","**Phase 1 – train the head.** The backbone is frozen, so only the new `Dense` layer learns. This prevents the random head from sending large\n","gradients back into the pre-trained features.\n","\n","**Phase 2 – fine-tune.** The top `FINE_TUNE_LAST` backbone layers are unfrozen and trained with a ~100× smaller learning rate.\n","BatchNorm layers stay frozen (standard practice for small-batch fine-tuning).\n","\n","Because the training set is now balanced, **class weights are no longer needed**."]},{"cell_type":"code","execution_count":11,"id":"10500ec0","metadata":{"execution":{"iopub.execute_input":"2026-10-23T19:54:08.048343Z","iopub.status.busy":"2026-10-23T19:54:08.047468Z","iopub.status.idle":"2026-10-23T20:06:05.203965Z","shell.execute_reply":"2026-10-23T20:06:05.20298