ource":["# ── Per-subclass analysis (uses the same THRESHOLD as the confusion matrix) ──\n","import pandas as pd\n","\n","def subclass_of(path, label):\n","    \"\"\"Subfolder name under the class folder, e.g. 'Pneumonia' / 'Lung Opacity'.\"\"\"\n","    class_folder = os.path.join(DATA_DIR, CLASS_NAMES[label])\n","    sub = os.path.relpath(os.path.dirname(path), class_folder)\n","    return CLASS_NAMES[label] if sub == \".\" else f\"{CLASS_NAMES[label]} / {sub}\"\n","\n","def wilson_ci(k, n, z=1.96):\n","    \"\"\"95% confidence interval for a proportion (works well for small n).\"\"\"\n","    if n == 0: return (np.nan, np.nan)\n","    p = k / n\n","    denom = 1 + z**2 / n\n","    centre = (p + z**2 / (2 * n)) / denom\n","    half = z * np.sqrt(p * (1 - p) / n + z**2 / (4 * n**2)) / denom\n","    return centre - half, centre + half\n","\n","y_pred = (y_prob >= THRESHOLD).astype(int)\n","groups = np.array([subclass_of(p, l) for p, l in zip(test_paths, test_labels)])\n","\n","rows = []\n","for g in sorted(set(groups)):\n","    m = groups == g\n","    k, n = int((y_pred[m] == y_true[m]).sum()), int(m.sum())\n","    lo, hi = wilson_ci(k, n)\n","    rows.append({\"subclass\": g, \"n_test\": n, \"correct\": k, \"errors\": n - k,\n","                 \"accuracy\": k / n, \"ci_low\": lo, \"ci_high\": hi,\n","                 \"mean_P(Abnormal)\": float(y_prob[m].mean())})\n","df_sub = pd.DataFrame(rows)\n","\n","print(f\"Threshold used: {THRESHOLD:.3f}\")\n","print(\"(accuracy = recall for Abnormal subclasses, specificity for Normal)\\n\")\n","print(df_sub.round(3).to_string(index=False))\n","\n","# Bar chart with 95% confidence intervals\n","fig, ax = plt.subplots(figsize=(1.8 * len(df_sub) + 3, 4.5))\n","x = np.arange(len(df_sub))\n","err = [np.clip(df_sub.accuracy - df_sub.ci_low, 0, None), np.clip(df_sub.ci_high - df_sub.accuracy, 0, None)]\n","colors = [\"tab:green\" if s.startswith(\"Normal\") else \"tab:red\" for s in df_sub.subclass]\n","ax.bar(x, df_sub.accuracy, yerr=err, capsize=6, color=colors, alpha=0.75)\n","for xi, (acc, n) in enumerate(zip(df_sub.accuracy, df_sub.n_test)):\n","    ax.text(xi, 0.505, f\"n={n}\", ha=\"center\", color=\"white\", fontsize=10)\n","ax.axhline(float((y_pred == y_true).mean()), color=\"gray\", ls=\"--\", label=\"overall accuracy\")\n","ax.set_xticks(x); ax.set_xticklabels(df_sub.subclass, rotation=15, ha=\"right\")\n","ax.set_ylim(0.5, 1.0); ax.set_ylabel(\"Correctly classified (95% CI)\")\n","ax.set_title(\"Test performance per subclass\"); ax.legend(loc=\"lower right\")\n","plt.tight_layout(); plt.show()\n","\n","# Optional: is the Pneumonia / Lung Opacity mix preserved in the training set?\n","train_groups = pd.Series([subclass_of(p, l) for p, l in zip(train_paths, train_labels)])\n","print(\"\\nTraining-set composition (real images only):\")\n","print(train_groups.value_counts().to_string())"]},{"cell_type":"markdown","id":"0215cce6","metadata":{"papermill":{"duration":0.179108,"end_time":"2026-11-04T20:57:06.135285+00:00","exception":false,"start_time":"2026-11-04T20:57:05.956177+00:00","status":"completed"},"tags":[]},"source":["## 8. Explainability with Grad-CAM\n","For a medical-imaging model it is important to check *where* the network looks. Grad-CAM highlights the regions that pushed the prediction\n","towards \"Abnormal\". If the heat sits on lung fields → good. If it sits on corners, text markers or devices → the model is taking a shortcut."]},{"cell_type":"code","execution_count":17,"id":"4a48b679","metadata":{"execution":{"iopub.execute_input":"2026-11-04T20:57:06.502021Z","iopub.status.busy":"2026-11-04T20:57:06.501591Z","iopub.status.idle":"2026-11-04T20:57:18.836971Z","shell.execute_reply":"2026-11-04T20:57:18.836123Z"},"papermill":{"duration":12.537476,"end_time":"2026-11-04T20:57:18.854645+00:00","exception":false,"start_time":"2026-11-04T20:57:06.317169+00:00","status":"completed"},"tags":[]},"outputs":[{"data":{"image/png":"\n","text/plain":["<Figure size 2040x700 with 12 Axes>"]},"metadata":{},"output_type":"display_data"}],"source":["def make_gradcam(model, img):\n","    \"\"\"img: float32 array [H,W,3] with values 0..255. Returns (heatmap in 0..1, P(Abnormal)).\"\"\"\n","    x = tf.convert_to_tensor(img[None], dtype=tf.float32)\n","    x = model.get_layer(\"preprocess\")(x)\n","    backbone, gap, pred = model.get_layer(\"backbone\"), model.get_layer(\"gap\"), model.get_layer(\"pred\")\n","    with tf.GradientTape() as tape:\n","        conv = backbone(x, training=False)          # last conv feature map\n","        tape.watch(conv)\n","        prob = pred(gap(conv))\n","        score = prob * 1024.0\n","    grads = tape.gradient(score, conv)\n","    weights = tf.reduce_mean(grads, axis=(1, 2), keepdims=True)\n","    cam = tf.nn.relu(tf.reduce_sum(tf.cast(weights, tf.float32) * tf.cast(conv, tf.float32), axis=-1))[0].numpy()\n","    cam = cam / (cam.max() + 1e-8)\n","    return cam, float(prob[0, 0])\n","\n","def show_gradcam(paths, true_labels, n=6, seed=0):\n","    rng = np.random.default_rng(seed)\n","    chosen = rng.choice(len(paths), min(n, len(paths)), replace=False)\n","    fig, axes = plt.subplots(2, len(chosen), figsize=(3.4 * len(chosen), 7))\n","    for j, i in enumerate(chosen):\n","        img = np.asarray(Image.open(paths[i]).convert(\"RGB\").resize(IMG_SIZE[::-1]), dtype=np.float32)\n","        cam, prob = make_gradcam(model, img)\n","        cam_up = np.array(Image.fromarray((cam * 255).astype(np.uint8)).resize(IMG_SIZE[::-1], Image.BICUBIC)) / 255.0\n","        axes[0, j].imshow(img.astype(np.uint8)); axes[0, j].axis(\"off\")\n","        axes[0, j].set_title(f\"True: {CLASS_NAMES[true_labels[i]]}\", fontsize=10)\n","        axes[1, j].imshow(img.astype(np.uint8)); axes[1, j].imshow(cam_up, cmap=\"jet\", alpha=0.4); axes[1, j].axis(\"off\")\n","        axes[1, j].set_title(f\"P(Abnormal)={prob:.2f}\", fontsize=10)\n","    plt.tight_layout(); plt.show()\n","\n","abn = [i for i, y in enumerate(test_labels) if y == 1]\n","show_gradcam([test_paths[i] for i in abn], [1] * len(abn), n=6)"]},{"cell_type":"code","execution_count":18,"id":"f57bf57f","metadata":{"execution":{"iopub.execute_input":"2026-11-04T20:57:19.245879Z","iopub.status.busy":"2026-11-04T20:57:19.245339Z","iopub.status.idle":"2026-11-04T20:57:26.128237Z","shell.execute_reply":"2026-11-04T20:57:26.127416Z"},"papermill":{"duration":7.092566,"end_time":"2026-11-04T20:57:26.144266+00:00","exception":false,"start_time":"2026-11-04T20:57:19.0517+00:00","status":"completed"},"tags":[]},"outputs":[{"name":"stdout","output_type":"stream","text":["65 false negatives:\n","Abnormal / Lung_Opacity    65\n"]},{"data":{"image/png":"\n","text/plain":["<Figure size 2040x700 with 12 Axes>"]},"metadata":{},"output_type":"display_data"}],"source":["fn_idx = [i for i in range(len(test_paths)) if y_true[i] == 1 and y_pred[i] == 0]\n","print(f\"{len(fn_idx)} false negatives:\")\n","print(pd.Series([subclass_of(test_paths[i], 1) for i in fn_idx]).value_counts().to_string())\n","\n","if fn_idx:\n","    show_gradcam([test_paths[i] for i in fn_idx], [1] * len(fn_idx), n=6, seed=1)\n","else:\n","    print(\"No false negatives at this threshold.\")"]},{"cell_type":"markdown","id":"7bb5d4b0","metadata":{"papermill":{"duration":0.219725,"end_time":"2026-11-04T20:57:26.584869+00:00","exception":false,"start_time":"2026-11-04T20:57:26.365144+00:00","status":"completed"},"tags":[]},"source":["## 9. Save the model & predict on a new image"]},{"cell_type":"code","execution_count":19,"id":"8e905ffe","metadata":{"execution":{"iopub.execute_input":"2026-11-04T20:57:27.019568Z","iopub.status.busy":"2026-11-04T20:57:27.019256Z","iopub.status.idle":"2026-11-04T20:57:43.583466Z","shell.execute_reply":"2026-11-04T20:57:43.582726Z"},"papermill":{"duration":16.782288,"end_time":"2026-11-04T20:57:43.586254+00:00","exception":false,"start_time":"2026-11-04T20:57:26.803966+00:00","status":"completed"},"tags":[]},"outputs":[{"name":"stdout","output_type":"stream",