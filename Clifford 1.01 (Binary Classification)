"tags":[]},"outputs":[{"name":"stdout","output_type":"stream","text":["Test results: {'accuracy': 0.9463, 'auc': 0.9881, 'loss': 0.133, 'precision': 0.9646, 'recall': 0.9347}\n","\n","Sensitivity (recall on Abnormal): 0.935\n","Specificity (recall on Normal)  : 0.960\n","ROC-AUC                          : 0.988\n","\n","              precision    recall  f1-score   support\n","\n","      Normal      0.926     0.960     0.943      1020\n","    Abnormal      0.965     0.935     0.949      1194\n","\n","    accuracy                          0.946      2214\n","   macro avg      0.945     0.947     0.946      2214\n","weighted avg      0.947     0.946     0.946      2214\n","\n"]}],"source":["results = model.evaluate(test_ds, return_dict=True, verbose=0)\n","print(\"Test results:\", {k: round(v, 4) for k, v in results.items()})\n","\n","y_true = np.array(test_labels)\n","y_prob = model.predict(test_ds, verbose=0).ravel()\n","THRESHOLD = 0.5\n","y_pred = (y_prob >= THRESHOLD).astype(int)\n","\n","cm = confusion_matrix(y_true, y_pred)\n","tn, fp, fn, tp = cm.ravel()\n","print(f\"\\nSensitivity (recall on Abnormal): {tp / (tp + fn):.3f}\")\n","print(f\"Specificity (recall on Normal)  : {tn / (tn + fp):.3f}\")\n","print(f\"ROC-AUC                          : {roc_auc_score(y_true, y_prob):.3f}\\n\")\n","print(classification_report(y_true, y_pred, target_names=CLASS_NAMES, digits=3))"]},{"cell_type":"code","execution_count":15,"id":"d85c2b76","metadata":{"execution":{"iopub.execute_input":"2026-10-23T20:27:19.474283Z","iopub.status.busy":"2026-10-23T20:27:19.473965Z","iopub.status.idle":"2026-10-23T20:27:19.725818Z","shell.execute_reply":"2026-10-23T20:27:19.725101Z"},"papermill":{"duration":0.552478,"end_time":"2026-10-23T20:27:19.728266+00:00","exception":false,"start_time":"2026-10-23T20:27:19.175788+00:00","status":"completed"},"tags":[]},"outputs":[{"data":{"image/png":"\n","text/plain":["<Figure size 1300x500 with 2 Axes>"]},"metadata":{},"output_type":"display_data"}],"source":["fig, axes = plt.subplots(1, 2, figsize=(13, 5))\n","ConfusionMatrixDisplay(cm, display_labels=CLASS_NAMES).plot(ax=axes[0], cmap=\"Blues\", colorbar=False)\n","axes[0].set_title(\"Confusion matrix (test)\")\n","\n","fpr, tpr, _ = roc_curve(y_true, y_prob)\n","axes[1].plot(fpr, tpr, label=f\"AUC = {roc_auc_score(y_true, y_prob):.3f}\")\n","axes[1].plot([0, 1], [0, 1], \"k--\", alpha=0.4)\n","axes[1].set_xlabel(\"False positive rate\"); axes[1].set_ylabel(\"True positive rate (sensitivity)\")\n","axes[1].set_title(\"ROC curve (test)\"); axes[1].legend(loc=\"lower right\")\n","plt.tight_layout(); plt.show()"]},{"cell_type":"markdown","id":"b156ade4","metadata":{"papermill":{"duration":0.306116,"end_time":"2026-10-23T20:27:20.327381+00:00","exception":false,"start_time":"2026-10-23T20:27:20.021265+00:00","status":"completed"},"tags":[]},"source":["**Reference point — the from-scratch CNN** reached ~0.935 test accuracy / ~0.979 AUC, but that number came from the old\n","`take`/`skip` split, so it is slightly optimistic and not strictly comparable. For a clean comparison, re-run that old model on this\n","notebook's split (the `train_ds` / `val_ds` / `test_ds` above work for any Keras model, just add `/255` scaling)."]},{"cell_type":"markdown","id":"34377cf6","metadata":{"papermill":{"duration":0.295811,"end_time":"2026-10-23T20:27:20.949111+00:00","exception":false,"start_time":"2026-10-23T20:27:20.6533+00:00","status":"completed"},"tags":[]},"source":["## 8. Explainability with Grad-CAM\n","For a medical-imaging model it is important to check *where* the network looks. Grad-CAM highlights the regions that pushed the prediction\n","towards \"Abnormal\". If the heat sits on lung fields → good. If it sits on corners, text markers or devices → the model is taking a shortcut."]},{"cell_type":"code","execution_count":16,"id":"f90306ca","metadata":{"execution":{"iopub.execute_input":"2026-10-23T20:27:21.651657Z","iopub.status.busy":"2026-10-23T20:27:21.651354Z","iopub.status.idle":"2026-10-23T20:27:28.750131Z","shell.execute_reply":"2026-10-23T20:27:28.74933Z"},"papermill":{"duration":7.520344,"end_time":"2026-10-23T20:27:28.766318+00:00","exception":false,"start_time":"2026-10-23T20:27:21.245974+00:00","status":"completed"},"tags":[]},"outputs":[{"data":{"image/png":"\n","text/plain":["<Figure size 2040x700 with 12 Axes>"]},"metadata":{},"output_type":"display_data"}],"source":["def make_gradcam(model, img):\n","    \"\"\"img: float32 array [H,W,3] with values 0..255. Returns (heatmap in 0..1, P(Abnormal)).\"\"\"\n","    x = tf.convert_to_tensor(img[None], dtype=tf.float32)\n","    x = model.get_layer(\"preprocess\")(x)\n","    backbone, gap, pred = model.get_layer(\"backbone\"), model.get_layer(\"gap\"), model.get_layer(\"pred\")\n","    with tf.GradientTape() as tape:\n","        conv = backbone(x, training=False)          # last conv feature map\n","        tape.watch(conv)\n","        prob = pred(gap(conv))\n","    grads = tape.gradient(prob, conv)\n","    weights = tf.reduce_mean(grads, axis=(1, 2), keepdims=True)\n","    cam = tf.nn.relu(tf.reduce_sum(weights * conv, axis=-1))[0].numpy()\n","    cam = cam / (cam.max() + 1e-8)\n","    return cam, float(prob[0, 0])\n","\n","def show_gradcam(paths, true_labels, n=6, seed=0):\n","    rng = np.random.default_rng(seed)\n","    chosen = rng.choice(len(paths), min(n, len(paths)), replace=False)\n","    fig, axes = plt.subplots(2, len(chosen), figsize=(3.4 * len(chosen), 7))\n","    for j, i in enumerate(chosen):\n","        img = np.asarray(Image.open(paths[i]).convert(\"RGB\").resize(IMG_SIZE[::-1]), dtype=np.float32)\n","        cam, prob = make_gradcam(model, img)\n","        cam_up = np.array(Image.fromarray((cam * 255).astype(np.uint8)).resize(IMG_SIZE[::-1], Image.BICUBIC)) / 255.0\n","        axes[0, j].imshow(img.astype(np.uint8)); axes[0, j].axis(\"off\")\n","        axes[0, j].set_title(f\"True: {CLASS_NAMES[true_labels[i]]}\", fontsize=10)\n","        axes[1, j].imshow(img.astype(np.uint8)); axes[1, j].imshow(cam_up, cmap=\"jet\", alpha=0.4); axes[1, j].axis(\"off\")\n","        axes[1, j].set_title(f\"P(Abnormal)={prob:.2f}\", fontsize=10)\n","    plt.tight_layout(); plt.show()\n","\n","abn = [i for i, y in enumerate(test_labels) if y == 1]\n","show_gradcam([test_paths[i] for i in abn], [1] * len(abn), n=6)"]},{"cell_type":"markdown","id":"f2b40349","metadata":{"papermill":{"duration":0.295059,"end_time":"2026-10-23T20:27:29.355719+00:00","exception":false,"start_time":"2026-10-23T20:27:29.06066+00:00","status":"completed"},"tags":[]},"source":["## 9. Save the model & predict on a new image"]},{"cell_type":"code","execution_count":17,"id":"56c3d675","metadata":{"execution":{"iopub.execute_input":"2026-10-23T20:27:29.952816Z","iopub.status.busy":"2026-10-23T20:27:29.951766Z","iopub.status.idle":"2026-10-23T20:27:46.587393Z","shell.execute_reply":"2026-10-23T20:27:46.586566Z"},"papermill":{"duration":16.935076,"end_time":"2026-10-23T20:27:46.590024+00:00","exception":false,"start_time":"2026-10-23T20:27:29.654948+00:00","status":"completed"},"tags":[]},"outputs":[{"name":"stdout","output_type":"stream","text":["Saved: /kaggle/working/clifford_densenet121.keras\n","INFO:tensorflow:Assets written to: /kaggle/working/clifford_densenet121_savedmodel/assets\n"]},{"name":"stderr","output_type":"stream","text":["INFO:tensorflow:Assets written to: /kaggle/working/clifford_densenet121_savedmodel/assets\n"]},{"name":"stdout","output_type":"stream","text":["Saved artifact at '/kaggle/working/clifford_densenet121_savedmodel'. The following endpoints are available:\n","\n","* Endpoint 'serve'\n","  args_0 (POSITIONAL_ONLY): TensorSpec(shape=(None, 224, 224, 3), dtype=tf.float32, name='image')\n","Output Type:\n","  TensorSpec(shape=(None, 1), dtype=tf.float32, name=None)\n","Captures:\n","  138776100241040: TensorSpec(shape=(), dtype=tf.resource, name=None)\n","  138773754565200: TensorSpec(shape=(), dtype=tf.resource, name=None)\n","  13877