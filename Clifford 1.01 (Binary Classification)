,"output_type":"execute_result"}],"source":["def predict_new_image(model, img_path, threshold=0.5, show_cam=True):\n","    img = Image.open(img_path).convert(\"RGB\").resize(IMG_SIZE[::-1])\n","    arr = np.asarray(img, dtype=np.float32)                   # raw 0..255 — preprocessing is inside the model\n","    prob = float(model.predict(arr[None], verbose=0)[0, 0])   # P(Abnormal)\n","    label = CLASS_NAMES[int(prob >= threshold)]\n","\n","    fig, axes = plt.subplots(1, 2 if show_cam else 1, figsize=(10 if show_cam else 5, 5))\n","    axes = np.atleast_1d(axes)\n","    axes[0].imshow(img); axes[0].axis(\"off\"); axes[0].set_title(f\"{label}  (P(Abnormal) = {prob:.2f})\")\n","    if show_cam:\n","        cam, _ = make_gradcam(model, arr)\n","        cam_up = np.array(Image.fromarray((cam * 255).astype(np.uint8)).resize(IMG_SIZE[::-1], Image.BICUBIC)) / 255.0\n","        axes[1].imshow(img); axes[1].imshow(cam_up, cmap=\"jet\", alpha=0.4); axes[1].axis(\"off\"); axes[1].set_title(\"Grad-CAM\")\n","    plt.show()\n","    return label, prob\n","\n","# Example:\n","predict_new_image(model, \"/kaggle/input/datasets/lyesaitk/test-images/Normal_test_image.jpg\")"]},{"cell_type":"code","execution_count":19,"id":"c231fc7f","metadata":{"execution":{"iopub.execute_input":"2026-10-23T20:27:53.553816Z","iopub.status.busy":"2026-10-23T20:27:53.553333Z","iopub.status.idle":"2026-10-23T20:27:54.855069Z","shell.execute_reply":"2026-10-23T20:27:54.854222Z"},"papermill":{"duration":1.609521,"end_time":"2026-10-23T20:27:54.86007+00:00","exception":false,"start_time":"2026-10-23T20:27:53.250549+00:00","status":"completed"},"tags":[]},"outputs":[{"data":{"image/png":"\n","text/plain":["<Figure size 1000x500 with 2 Axes>"]},"metadata":{},"output_type":"display_data"},{"data":{"text/plain":["('Abnormal', 0.9832356572151184)"]},"execution_count":19,"metadata":{},"output_type":"execute_result"}],"source":["# Example 2\n","predict_new_image(model, \"/kaggle/input/datasets/lyesaitk/test-imag